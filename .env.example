# Supabase Dashboard → Connect / Project Settings → API
# Browser-safe publishable/anon key only. NEVER use a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only PostgreSQL connection for npm run db:push / db:verify.
# Use the Session pooler URI from Supabase Connect (port 5432).
# Never add a VITE_ prefix to this credential.
SUPABASE_DB_URL=
SUPABASE_DB_CA_FILE=supabase/certs/prod-ca-2021.crt

# Leaving BOTH frontend fields empty enables browser-local demo mode.
# Store actual values in .env.local, which is ignored by Git.
